{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/treatments",
      "destination": "/index.html"
    },
    {
      "source": "/treatments/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/conditions",
      "destination": "/index.html"
    },
    {
      "source": "/conditions/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/pages/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/index.html"
    }
  ]
}
